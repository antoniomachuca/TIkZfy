<style>
  #geometry-background { opacity: 0.9; }
  #geometry-shapes > * { transform-box: fill-box; transform-origin: center; }

  @media (prefers-reduced-motion: no-preference) {
    #geometry-svg > rect:first-of-type { animation: grid-drift 14s linear infinite; }
    #geometry-shapes > * {
      stroke-dasharray: 800;
      animation: trace-shape 7s ease-in-out infinite alternate;
    }
    #geometry-shapes > *:nth-child(odd) { animation: trace-shape 7s ease-in-out infinite alternate, float-shape 10s ease-in-out infinite alternate; }
    #geometry-shapes > *:nth-child(even) { animation: trace-shape 8s ease-in-out 0.8s infinite alternate, float-shape-reverse 12s ease-in-out infinite alternate; }
  }

  @keyframes grid-drift {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(24px, 16px, 0); }
  }

  @keyframes trace-shape {
    from { stroke-dashoffset: 800; opacity: 0.08; }
    to { stroke-dashoffset: 0; opacity: 0.24; }
  }

  @keyframes float-shape {
    from { transform: translate3d(0, 0, 0) rotate(0deg); }
    to { transform: translate3d(12px, -10px, 0) rotate(2deg); }
  }

  @keyframes float-shape-reverse {
    from { transform: translate3d(0, 0, 0) rotate(0deg); }
    to { transform: translate3d(-10px, 12px, 0) rotate(-2deg); }
  }
</style>
