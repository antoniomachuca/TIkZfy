---
import { masterCodeString } from '../data/mathFigures.js';
---
<div id="brutal-background" class="fixed inset-0 z-[-1] overflow-hidden pointer-events-none select-none bg-white">
  <div class="absolute top-0 bottom-0 left-0 w-[55%] overflow-hidden opacity-30 mask-fade">
    <div id="typing-canvas" data-master={masterCodeString} class="font-mono text-[7px] md:text-[9px] text-gray-500 break-all whitespace-pre-wrap leading-tight w-full h-full text-justify pl-4 py-0 pr-12" style="letter-spacing: -0.5px;">
    </div>
  </div>
</div>

<style>
  .mask-fade {
    mask-image: linear-gradient(to right, black 70%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, black 70%, transparent 100%);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const canvas = document.getElementById('typing-canvas');
    if (!canvas) return;

    const masterCodeString = canvas.dataset.master;
    let currentText = "";
    let charIndex = 0;
    const charsPerFrame = 17; 
    const infiniteString = masterCodeString;
    let hasFilled = false;

    const typeLoop = () => {
      const charsToAdd = hasFilled ? 200 : charsPerFrame;
      currentText += infiniteString.substring(charIndex, charIndex + charsToAdd);
      charIndex = (charIndex + charsToAdd) % infiniteString.length;

      if (canvas.scrollHeight > window.innerHeight * 1.5) {
        const trimAmount = 1500;
        currentText = currentText.substring(trimAmount);
      }

      canvas.textContent = currentText + "█";
      
      if (!hasFilled && canvas.scrollHeight > window.innerHeight) {
        hasFilled = true;
        window.isTikzFilled = true;
        window.dispatchEvent(new Event('tikzFilled'));
      }
      
      if (!hasFilled) {
        window.scrollTo(0, document.body.scrollHeight);
      }

      const nextDelay = hasFilled ? 150 : 20;
      setTimeout(typeLoop, nextDelay);
    };
    
    requestAnimationFrame(typeLoop);
  });
</script>
