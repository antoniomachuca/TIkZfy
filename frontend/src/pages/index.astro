---
import Layout from '../layouts/Layout.astro';
import InteractiveGeometry from '../components/InteractiveGeometry.astro';
---

<Layout>
  <div class="fixed inset-0 pointer-events-none overflow-hidden z-10 text-white">
    <h1 class="absolute top-16 left-4 sm:top-20 md:top-8 md:left-6 text-[clamp(3.5rem,12vw,12rem)] font-black tracking-tighter-massive leading-none reveal-title">TIkZfy</h1>
  </div>

  <InteractiveGeometry />

  <main class="relative z-30 min-h-screen flex flex-col items-center justify-center p-4 pt-16 md:pt-24">
    <section id="landing-view" class="flex flex-col items-center max-w-2xl w-full mt-16 sm:mt-20 md:mt-16">
      <div id="compiler-card" class="w-full bg-white border-2 border-black p-4 sm:p-6 md:p-8 shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] relative z-20">
        <div class="absolute top-3 right-3 sm:top-4 sm:right-5 flex items-center gap-2 text-black select-none pointer-events-none" aria-hidden="true">
          <svg class="w-3 h-3" viewBox="0 0 16 16" fill="none">
            <path d="M3 8H13" stroke="currentColor" stroke-width="2" stroke-linecap="square" />
          </svg>
          <svg class="w-3 h-3" viewBox="0 0 16 16" fill="none">
            <rect x="3" y="3" width="10" height="10" stroke="currentColor" stroke-width="2" />
          </svg>
          <svg class="w-3 h-3" viewBox="0 0 16 16" fill="none">
            <path d="M3.5 3.5L12.5 12.5M12.5 3.5L3.5 12.5" stroke="currentColor" stroke-width="2" stroke-linecap="square" />
          </svg>
        </div>

        <div class="text-center">
          <p class="font-mono text-[10px] uppercase tracking-[0.3em] mb-3">Upload an image</p>
          <h2 class="text-2xl md:text-3xl font-black uppercase tracking-tight mb-2">Convert an image to TikZ</h2>
          <p class="text-sm font-mono text-black/70">Get editable TikZ code from your image.</p>
        </div>

        <div id="drop-zone" tabindex="0" role="button" aria-label="Drop an image here" class="w-full mt-5 border-2 border-dashed border-black p-7 sm:p-9 text-center cursor-pointer hover:bg-black hover:text-white focus:bg-black focus:text-white transition-colors duration-300 group">
          <svg class="mx-auto mb-3 w-10 h-10" viewBox="0 0 48 48" fill="none" aria-hidden="true">
            <path d="M24 34V8M24 8L14 18M24 8L34 18M8 30V40H40V30" stroke="currentColor" stroke-width="2" />
          </svg>
          <span class="font-mono uppercase text-xs tracking-widest group-hover:text-white">Drop an image</span>
          <span class="block mt-2 text-[10px] font-mono opacity-60">PNG, JPG or WEBP</span>
        </div>

        <div class="flex items-center w-full gap-4 opacity-70 my-4">
          <div class="h-px bg-black flex-1"></div>
          <span class="text-[10px] uppercase font-mono tracking-widest font-bold">OR</span>
          <div class="h-px bg-black flex-1"></div>
        </div>

        <label for="file-upload" class="w-full block text-center px-8 py-3 bg-white border-2 border-black hover:bg-black hover:text-white focus-within:bg-black focus-within:text-white font-bold uppercase tracking-wider transition-colors duration-300 cursor-pointer text-sm">
          Choose an image
        </label>
        <input id="file-upload" type="file" class="sr-only" accept="image/png,image/jpeg,image/webp" />
      </div>
    </section>

    <section id="processing-view" aria-live="polite" class="hidden flex-col items-center w-full max-w-3xl -mt-6 sm:-mt-10 md:-mt-14 bg-white border-2 border-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] p-6 sm:p-8 relative z-20">
      <div class="w-full flex justify-between items-start gap-4 mb-8">
        <div>
        <p class="font-mono text-[10px] uppercase tracking-[0.3em] mb-2">Engine status</p>
        <h2 class="text-2xl font-black uppercase">Extracting geometry</h2>
        </div>
      <span id="progress-value" class="font-mono text-2xl font-bold">0%</span>
      </div>

      <div class="w-full border-2 border-black p-2 mb-8">
        <div id="progress-bar" class="h-3 bg-black transition-[width] duration-300" style="width: 0%"></div>
      </div>

      <div class="vector-loader w-full aspect-video border-2 border-black bg-[#f3f3f0] flex items-center justify-center overflow-hidden" aria-hidden="true">
        <svg viewBox="0 0 640 360" class="w-full h-full" fill="none">
          <path class="vector-line vector-line-one" d="M40 280C130 80 200 320 300 150S480 100 600 260" stroke="black" stroke-width="3" />
          <path class="vector-line vector-line-two" d="M80 80L180 270L320 90L470 280L560 100" stroke="black" stroke-width="2" />
          <circle class="vector-node" cx="180" cy="270" r="7" fill="white" stroke="black" stroke-width="3" />
          <circle class="vector-node" cx="320" cy="90" r="7" fill="white" stroke="black" stroke-width="3" />
          <circle class="vector-node" cx="470" cy="280" r="7" fill="white" stroke="black" stroke-width="3" />
        </svg>
      </div>

      <div class="w-full grid grid-cols-3 gap-2 mt-6 font-mono text-[10px] uppercase tracking-wider">
        <span id="stage-image" class="stage active">01 / image</span>
        <span id="stage-geometry" class="stage">02 / geometry</span>
        <span id="stage-compile" class="stage">03 / compile</span>
      </div>
    </section>

    <section id="error-view" aria-live="assertive" class="hidden flex-col w-full max-w-3xl -mt-6 sm:-mt-10 md:-mt-14 bg-white border-2 border-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] p-6 sm:p-8 relative z-20">
      <p class="font-mono text-[10px] uppercase tracking-[0.3em] mb-3">Engine status / failed</p>
      <h2 class="text-2xl font-black uppercase mb-3">Generation interrupted</h2>
      <p id="error-message" class="font-mono text-sm border-l-4 border-black pl-4 mb-8">We could not process that image.</p>
      <div class="flex flex-col sm:flex-row gap-3">
        <button id="btn-retry" class="font-mono uppercase text-xs font-bold px-4 py-3 border-2 border-black bg-black text-white hover:bg-white hover:text-black transition-colors">Try again</button>
        <button id="btn-error-back" class="font-mono uppercase text-xs font-bold px-4 py-3 border-2 border-black hover:bg-black hover:text-white transition-colors">Choose another image</button>
      </div>
    </section>

    <section id="results-view" class="hidden flex-col items-center w-full max-w-6xl -mt-6 sm:-mt-10 md:-mt-14 bg-white border-2 border-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] p-4 sm:p-6 relative z-20">
      <div class="w-full flex flex-col sm:flex-row justify-between sm:items-center gap-3 mb-3 pb-3 border-b border-black">
        <div>
          <p class="font-mono text-[9px] uppercase tracking-[0.3em] opacity-70">Engine status / complete</p>
          <h2 class="text-xl sm:text-2xl font-black uppercase">Geometric Reconstruction</h2>
        </div>
        <div class="flex flex-wrap gap-2">
          <button id="btn-toggle-code" class="font-mono uppercase text-xs font-bold px-3.5 py-1.5 border-2 border-black bg-white hover:bg-black hover:text-white transition-colors flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
            <span id="toggle-code-label">View TikZ Code</span>
          </button>
          <button id="btn-copy" class="font-mono uppercase text-xs font-bold px-3.5 py-1.5 border-2 border-black hover:bg-black hover:text-white transition-colors">Copy code</button>
          <button id="btn-save" class="font-mono uppercase text-xs font-bold px-3.5 py-1.5 border-2 border-black bg-black text-white hover:bg-white hover:text-black transition-colors">Save .tex</button>
        </div>
      </div>

      <!-- Interactive Split-Comparison Viewer -->
      <div class="w-full flex flex-col gap-3">
        <div id="comparison-slider" class="relative w-full h-80 sm:h-96 md:h-[28rem] lg:h-[31rem] border-2 border-black bg-[#f3f3f0] overflow-hidden select-none touch-none shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] cursor-ew-resize">
          <!-- Background: Compiled TikZ Preview (Revealed on Right) -->
          <div class="absolute inset-0 w-full h-full flex items-center justify-center bg-white pointer-events-none select-none">
            <img id="preview-image" src="" alt="Compiled TikZ preview" draggable="false" class="w-full h-full object-contain p-4 bg-white pointer-events-none select-none" />
            <p id="preview-empty" class="px-6 text-center font-mono text-xs leading-relaxed hidden">The API returned TikZ code but no preview URL.</p>
          </div>

          <!-- Foreground Overlay: Uploaded User Image (Clipped on Left) -->
          <div id="comparison-clip" class="absolute inset-0 w-full h-full flex items-center justify-center bg-white overflow-hidden pointer-events-none select-none" style="clip-path: inset(0 50% 0 0);">
            <img id="uploaded-image" src="" alt="Original uploaded image" draggable="false" class="w-full h-full object-contain p-4 bg-white pointer-events-none select-none" />
          </div>

          <!-- Vertical Divider Bar & Grab Handle -->
          <div id="comparison-handle" class="absolute top-0 bottom-0 w-0.5 bg-black flex items-center justify-center z-10 pointer-events-none select-none" style="left: 50%;">
            <div class="w-8 h-8 -ml-4 bg-white border-2 border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] flex items-center justify-center font-mono text-[11px] font-bold select-none">
              ↔
            </div>
          </div>

          <!-- Native Ultra-smooth Range Overlay -->
          <input
            id="comparison-range"
            type="range"
            min="0"
            max="100"
            value="50"
            step="0.1"
            aria-label="Image comparison slider"
            class="absolute inset-0 w-full h-full opacity-0 cursor-ew-resize z-20 m-0 p-0"
          />

          <!-- Top Corner Badges -->
          <span class="absolute top-2.5 left-2.5 bg-black text-white font-mono text-[8px] sm:text-[9px] uppercase tracking-wider px-2 py-0.5 z-10 pointer-events-none select-none">
            Original Photo
          </span>
          <span class="absolute top-2.5 right-2.5 bg-black text-white font-mono text-[8px] sm:text-[9px] uppercase tracking-wider px-2 py-0.5 z-10 pointer-events-none select-none">
            Compiled TikZ
          </span>
        </div>

        <!-- Collapsible TikZ Source Code Section -->
        <div id="code-drawer" class="hidden w-full border-2 border-black bg-black transition-all duration-300">
          <div class="flex justify-between items-center px-3 py-2 border-b border-white/20 text-white">
            <span class="font-mono text-[9px] uppercase tracking-widest font-bold">TikZ source code</span>
            <span id="token-count" class="font-mono text-[9px] uppercase text-white/70"></span>
          </div>
          <pre id="code-output" class="max-h-48 sm:max-h-60 overflow-auto bg-black text-emerald-400 p-3 text-xs leading-relaxed font-mono whitespace-pre-wrap selection:bg-white selection:text-black"></pre>
        </div>
      </div>

      <div class="w-full flex justify-start items-center mt-3 pt-2.5 border-t border-black">
        <button id="btn-back" class="font-mono uppercase text-xs font-bold px-4 py-2 border-2 border-black hover:bg-black hover:text-white transition-colors">← Choose another image</button>
      </div>
    </section>
  </main>
</Layout>

<style>
  .stage { opacity: 0.35; border-top: 2px solid currentColor; padding-top: 0.5rem; }
  .stage.active { opacity: 1; }
  .vector-line { stroke-dasharray: 900; stroke-dashoffset: 900; animation: draw-vector 2.5s ease-in-out infinite alternate; }
  .vector-line-two { animation-delay: 0.4s; }
  .vector-node { animation: pulse-node 1.5s ease-in-out infinite alternate; }
  .vector-node:nth-of-type(2) { animation-delay: 0.2s; }
  .vector-node:nth-of-type(3) { animation-delay: 0.4s; }

  #compiler-card {
    cursor: grab;
    touch-action: none;
  }

  #compiler-card.is-dragging {
    cursor: grabbing !important;
    user-select: none;
    transition: none !important;
  }

  #drop-zone,
  label[for="file-upload"] {
    cursor: pointer !important;
  }

  #comparison-slider {
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
  }

  #comparison-slider img {
    -webkit-user-drag: none;
    -khtml-user-drag: none;
    -moz-user-drag: none;
    -o-user-drag: none;
    user-drag: none;
    user-select: none;
    -webkit-user-select: none;
    pointer-events: none;
  }

  #comparison-range {
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
    cursor: ew-resize;
  }

  #comparison-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 60px;
    height: 100%;
    cursor: ew-resize;
    opacity: 0;
  }

  #comparison-range::-moz-range-thumb {
    width: 60px;
    height: 100%;
    cursor: ew-resize;
    opacity: 0;
  }

  @keyframes draw-vector { to { stroke-dashoffset: 0; } }
  @keyframes pulse-node { from { r: 4; } to { r: 9; } }

  @media (prefers-reduced-motion: reduce) {
    .vector-line, .vector-node { animation: none; }
    .vector-line { stroke-dashoffset: 0; }
    * { scroll-behavior: auto !important; transition-duration: 0.01ms !important; }
  }
</style>

<script>
  import anime from 'animejs';
  import { generateTikzFromImage } from '../utils/apiClient';

  const initApp = () => {
    const dropZone = document.getElementById('drop-zone');
    const fileUpload = document.getElementById('file-upload');
    const landingView = document.getElementById('landing-view');
    const processingView = document.getElementById('processing-view');
    const resultsView = document.getElementById('results-view');
    const errorView = document.getElementById('error-view');
    const errorMessage = document.getElementById('error-message');
    const progressBar = document.getElementById('progress-bar');
    const progressValue = document.getElementById('progress-value');
    const codeOutput = document.getElementById('code-output');
    const codeDrawer = document.getElementById('code-drawer');
    const btnToggleCode = document.getElementById('btn-toggle-code');
    const toggleCodeLabel = document.getElementById('toggle-code-label');
    const previewImage = document.getElementById('preview-image');
    const uploadedImage = document.getElementById('uploaded-image');
    const comparisonSlider = document.getElementById('comparison-slider');
    const comparisonClip = document.getElementById('comparison-clip');
    const comparisonHandle = document.getElementById('comparison-handle');
    const comparisonRange = document.getElementById('comparison-range');
    const previewEmpty = document.getElementById('preview-empty');
    const tokenCount = document.getElementById('token-count');
    const btnBack = document.getElementById('btn-back');
    const btnErrorBack = document.getElementById('btn-error-back');
    const btnRetry = document.getElementById('btn-retry');
    const btnCopy = document.getElementById('btn-copy');
    const btnSave = document.getElementById('btn-save');
    const stageImage = document.getElementById('stage-image');
    const stageGeometry = document.getElementById('stage-geometry');
    const stageCompile = document.getElementById('stage-compile');
    let selectedFile;
    let uploadedObjectUrl = '';
    let generatedCode = '';
    let progressTimer;

    if (!dropZone || !fileUpload) return;

    anime({ targets: '.reveal-title', opacity: [0, 1], translateX: [-50, 0], duration: 1500, easing: 'easeOutExpo' });

    const setView = (view) => {
      [landingView, processingView, resultsView, errorView].forEach((element) => {
        if (element) {
          element.classList.toggle('hidden', element !== view);
          element.classList.toggle('flex', element === view);
        }
      });
    };

    const updateProgress = (value) => {
      if (progressBar) progressBar.style.width = `${value}%`;
      if (progressValue) progressValue.textContent = `${value}%`;
      if (stageImage) stageImage.classList.toggle('active', value < 35);
      if (stageGeometry) stageGeometry.classList.toggle('active', value >= 35 && value < 75);
      if (stageCompile) stageCompile.classList.toggle('active', value >= 75);
    };

    const showError = (error) => {
      window.clearInterval(progressTimer);
      if (errorMessage) errorMessage.textContent = error instanceof Error ? error.message : 'We could not process that image.';
      setView(errorView);
    };

    const applyComparisonPercent = (percent) => {
      const clamped = Math.max(0, Math.min(percent, 100));
      if (comparisonClip) comparisonClip.style.clipPath = `inset(0 ${100 - clamped}% 0 0)`;
      if (comparisonHandle) comparisonHandle.style.left = `${clamped}%`;
      if (comparisonRange && parseFloat(comparisonRange.value) !== clamped) {
        comparisonRange.value = String(clamped);
      }
    };

    if (comparisonRange) {
      comparisonRange.addEventListener('input', (event) => {
        const target = event.target;
        if (target && 'value' in target) {
          applyComparisonPercent(parseFloat(target.value));
        }
      });
    }

    if (btnToggleCode && codeDrawer && toggleCodeLabel) {
      btnToggleCode.addEventListener('click', () => {
        const isHidden = codeDrawer.classList.toggle('hidden');
        toggleCodeLabel.textContent = isHidden ? 'View TikZ Code' : 'Hide TikZ Code';
      });
    }

    const processFile = async (file) => {
      if (!file || !file.type.startsWith('image/')) {
        showError(new Error('Please select a PNG, JPG or WEBP image.'));
        return;
      }

      selectedFile = file;
      if (uploadedObjectUrl) {
        URL.revokeObjectURL(uploadedObjectUrl);
      }
      uploadedObjectUrl = URL.createObjectURL(file);
      if (uploadedImage) {
        uploadedImage.src = uploadedObjectUrl;
      }

      applyComparisonPercent(50);

      setView(processingView);
      updateProgress(8);
      let progress = 8;
      progressTimer = window.setInterval(() => {
        progress = Math.min(progress + 4, 88);
        updateProgress(progress);
      }, 180);

      try {
        const result = await generateTikzFromImage(file);
        window.clearInterval(progressTimer);
        updateProgress(100);
        generatedCode = result.tikzCode;
        if (codeOutput) codeOutput.textContent = generatedCode;
        if (tokenCount) tokenCount.textContent = `${generatedCode.trim().split(/\s+/).length} tokens`;
        if (previewImage) {
          previewImage.src = result.previewUrl || '';
          previewImage.classList.toggle('hidden', !result.previewUrl);
        }
        if (previewEmpty) {
          previewEmpty.classList.toggle('hidden', Boolean(result.previewUrl));
        }
        setTimeout(() => setView(resultsView), 250);
      } catch (error) {
        showError(error);
      }
    };

    const reset = () => {
      window.clearInterval(progressTimer);
      if (uploadedObjectUrl) {
        URL.revokeObjectURL(uploadedObjectUrl);
        uploadedObjectUrl = '';
      }
      setView(landingView);
      if (fileUpload) fileUpload.value = '';
      updateProgress(0);
    };

    dropZone.addEventListener('click', () => fileUpload.click());
    dropZone.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') fileUpload.click();
    });
    dropZone.addEventListener('dragover', (event) => {
      event.preventDefault();
      dropZone.classList.add('bg-black', 'text-white');
    });
    dropZone.addEventListener('dragleave', () => dropZone.classList.remove('bg-black', 'text-white'));
    dropZone.addEventListener('drop', (event) => {
      event.preventDefault();
      dropZone.classList.remove('bg-black', 'text-white');
      if (event.dataTransfer && event.dataTransfer.files[0]) {
        processFile(event.dataTransfer.files[0]);
      }
    });
    fileUpload.addEventListener('change', () => {
      if (fileUpload.files && fileUpload.files[0]) {
        processFile(fileUpload.files[0]);
      }
    });
    if (btnBack) btnBack.addEventListener('click', reset);
    if (btnErrorBack) btnErrorBack.addEventListener('click', reset);
    if (btnRetry) btnRetry.addEventListener('click', () => processFile(selectedFile));
    if (btnCopy) {
      btnCopy.addEventListener('click', async () => {
        await navigator.clipboard.writeText(generatedCode);
        btnCopy.innerHTML = `
          <svg class="w-3.5 h-3.5 text-emerald-600 inline-block mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Copied!</span>
        `;
        btnCopy.classList.add('border-emerald-600', 'text-emerald-700');
        setTimeout(() => {
          btnCopy.innerHTML = 'Copy code';
          btnCopy.classList.remove('border-emerald-600', 'text-emerald-700');
        }, 1600);
      });
    }
    if (btnSave) {
      btnSave.addEventListener('click', () => {
        const link = document.createElement('a');
        link.href = URL.createObjectURL(new Blob([generatedCode], { type: 'text/plain' }));
        link.download = 'generated-figure.tex';
        link.click();
        URL.revokeObjectURL(link.href);

        btnSave.innerHTML = `
          <svg class="w-3.5 h-3.5 text-emerald-400 inline-block mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Saved!</span>
        `;
        setTimeout(() => {
          btnSave.innerHTML = 'Save .tex';
        }, 1600);
      });
    }

    const compilerCard = document.getElementById('compiler-card');
    let isDragging = false;
    let dragOffsetX = 0;
    let dragOffsetY = 0;

    const startDrag = (event) => {
      const target = event.target;
      if (!target || !compilerCard) return;
      if (target.closest('#drop-zone') || target.closest('label[for="file-upload"]') || target.closest('input')) {
        return;
      }
      if (event.button !== 0 && event.pointerType === 'mouse') {
        return;
      }

      isDragging = true;
      const rect = compilerCard.getBoundingClientRect();
      dragOffsetX = event.clientX - rect.left;
      dragOffsetY = event.clientY - rect.top;

      if (compilerCard.style.position !== 'fixed') {
        compilerCard.style.width = `${rect.width}px`;
        compilerCard.style.position = 'fixed';
        compilerCard.style.left = `${rect.left}px`;
        compilerCard.style.top = `${rect.top}px`;
        compilerCard.style.margin = '0';
      }

      compilerCard.classList.add('is-dragging');
      document.body.style.userSelect = 'none';
    };

    const onDrag = (event) => {
      if (!isDragging || !compilerCard) return;
      compilerCard.style.left = `${event.clientX - dragOffsetX}px`;
      compilerCard.style.top = `${event.clientY - dragOffsetY}px`;
    };

    const stopDrag = () => {
      if (!isDragging || !compilerCard) return;
      isDragging = false;
      compilerCard.classList.remove('is-dragging');
      document.body.style.userSelect = '';
    };

    if (compilerCard) {
      compilerCard.addEventListener('pointerdown', startDrag);
      window.addEventListener('pointermove', onDrag);
      window.addEventListener('pointerup', stopDrag);
      window.addEventListener('pointercancel', stopDrag);
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initApp);
  } else {
    initApp();
  }
</script>
