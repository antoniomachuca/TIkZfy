---
import '../styles/global.css';
import BackgroundTikZ from '../components/BackgroundTikZ.astro';

interface Props {
	title?: string;
  hideBackground?: boolean;
}

const { title = "TikZfy — Image to TikZ Engine", hideBackground = false } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
		<link rel="icon" href={`${baseUrl}favicon.svg`} />
		<meta name="generator" content={Astro.generator} />
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
		
		<title>{title}</title>
	</head>
	<body class="relative min-h-screen text-black bg-white">
		{!hideBackground && <BackgroundTikZ />}
		
    <nav class="fixed top-0 left-0 w-full p-4 flex justify-between items-start z-50 mix-blend-difference text-white font-mono text-xs uppercase tracking-widest pointer-events-none">
      <div class="flex items-center gap-6 md:gap-12">
        <a href={import.meta.env.BASE_URL} aria-label="Tikzfy Home" class="pointer-events-auto flex items-center group">
          <svg class="w-5 h-5 overflow-visible" viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <path class="logo-arrow" d="M14 48 L46 16 L34 16 L48 14 L46 28 L46 16" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
            <path class="logo-base" d="M14 48 L28 48 L14 34 Z" fill="currentColor" />
            <circle class="logo-dot" cx="51" cy="13" r="3.51" fill="currentColor" />
          </svg>
        </a>
        <span class="hidden md:inline text-white/70">Image to TikZ</span>
      </div>
      <div class="flex gap-6 md:gap-12">
        <a href={`${baseUrl}about/`} class="pointer-events-auto hover:underline">About</a>
        <a href="https://github.com/antoniomachuca/tikzfy" target="_blank" class="pointer-events-auto hover:underline">GitHub</a>
        <a href="https://ko-fi.com/antoniomachuca" target="_blank" class="pointer-events-auto hover:underline">Ko-fi</a>
      </div>
    </nav>

		<main class="relative z-10 w-full min-h-screen">
			<slot />
		</main>

    <style>
      .logo-arrow,
      .logo-base,
      .logo-dot {
        transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s ease;
        transform-box: fill-box;
        transform-origin: center;
      }
      .group:hover .logo-arrow {
        transform: translate(2.5px, -2.5px);
      }
      .group:hover .logo-base {
        transform: translate(-3.5px, 3.5px);
      }
      .group:hover .logo-dot {
        transform: translate(6px, -6px) scale(1.15);
      }
    </style>
	</body>
</html>
