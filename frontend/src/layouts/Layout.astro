---
import '../styles/global.css';
import BackgroundTikZ from '../components/BackgroundTikZ.astro';

interface Props {
	title?: string;
  hideBackground?: boolean;
}

const { title = "Tikzfy - Code Driven Design", hideBackground = false } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
		
		<title>{title}</title>
	</head>
	<body class="relative min-h-screen text-black bg-white">
		{!hideBackground && <BackgroundTikZ />}
		
    <nav class="fixed top-0 left-0 w-full p-4 flex justify-between items-start z-50 mix-blend-difference text-white font-mono text-xs uppercase tracking-widest pointer-events-none">
      <div class="flex gap-6 md:gap-12">
        <a href="/" class="pointer-events-auto hover:underline">Tikzfy v1.0</a>
        <span class="hidden md:inline">Algorithmic Vectorization</span>
      </div>
      <div class="flex gap-6 md:gap-12">
        <a href="/about" class="pointer-events-auto hover:underline">About</a>
        <a href="https://github.com/antoniomachuca/image-to-tikz-engine" target="_blank" class="pointer-events-auto hover:underline">GitHub</a>
        <a href="https://ko-fi.com/antoniomachuca" target="_blank" class="pointer-events-auto hover:underline">Ko-fi</a>
      </div>
    </nav>

		<main class="relative z-10 w-full min-h-screen">
			<slot />
		</main>
	</body>
</html>
