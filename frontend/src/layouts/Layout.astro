---
import '../styles/global.css';
import BackgroundTikZ from '../components/BackgroundTikZ.astro';

interface Props {
	title?: string;
  hideBackground?: boolean;
}

const { title = "Tikzfy - Image to TikZ Engine", hideBackground = false } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
		<link rel="icon" href={`${baseUrl}favicon.svg`} />
		<meta name="generator" content={Astro.generator} />
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
		
		<title>{title}</title>
	</head>
	<body class="relative min-h-screen text-black bg-white">
		{!hideBackground && <BackgroundTikZ />}
		
    <nav class="fixed top-0 left-0 w-full p-4 flex justify-between items-start z-50 mix-blend-difference text-white font-mono text-xs uppercase tracking-widest pointer-events-none">
      <div class="flex items-center gap-6 md:gap-12">
        <a href={import.meta.env.BASE_URL} aria-label="Tikzfy Home" class="pointer-events-auto flex items-center hover:opacity-75 transition-opacity">
          <svg class="w-5 h-5" viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <path d="M14 48 L46 16 L34 16 L48 14 L46 28 L46 16" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
            <path d="M14 48 L28 48 L14 34 Z" fill="currentColor" />
            <circle cx="51" cy="13" r="3.51" fill="currentColor" />
          </svg>
        </a>
        <span class="hidden md:inline text-white/70">Algorithmic Vectorization</span>
      </div>
      <div class="flex gap-6 md:gap-12">
        <a href={`${import.meta.env.BASE_URL}/about`} class="pointer-events-auto hover:underline">About</a>
        <a href="https://github.com/antoniomachuca/image-to-tikz-engine" target="_blank" class="pointer-events-auto hover:underline">GitHub</a>
        <a href="https://ko-fi.com/antoniomachuca" target="_blank" class="pointer-events-auto hover:underline">Ko-fi</a>
      </div>
    </nav>

		<main class="relative z-10 w-full min-h-screen">
			<slot />
		</main>
	</body>
</html>
