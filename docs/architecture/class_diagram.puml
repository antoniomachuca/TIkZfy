@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 80

package "core.models" {
    class ImageTensor <<Immutable>> {
        + raw_tensor : Tensor
        + __init__(tensor_data: Tensor) <<Throws DomainException>>
    }

    class TikzTokens <<Immutable>> {
        + markup : str
        + __init__(markup_string: str) <<Throws DomainException>>
    }

    class CompilationResult <<Immutable>> {
        + pdf_data : bytes
        + is_successful : bool
        + __init__(data: bytes, success: bool)
    }
}

package "ports.inbound" {
    interface GenerateTikzUseCase {
        + execute(image: ImageTensor) : CompilationResult
    }
}

package "ports.outbound" {
    interface VLMInferencePort {
        + predict_markup(image: ImageTensor) : TikzTokens
    }

    interface TikZCompilerPort {
        + compile_to_pdf(tokens: TikzTokens) : CompilationResult
    }
}

package "core" {
    class ImageToTikZOrchestrator {
        - vlm_port : VLMInferencePort
        - compiler_port : TikZCompilerPort
        + __init__(vlm: VLMInferencePort, compiler: TikZCompilerPort)
        + execute(image: ImageTensor) : CompilationResult
    }
}

package "adapters.inbound" {
    class GenerateRequestDTO <<DTO>> {
        + image_bytes : bytes
    }

    class FastAPIController {
        - use_case : GenerateTikzUseCase
        + __init__(use_case: GenerateTikzUseCase)
        + handle_generate_request(payload: GenerateRequestDTO) : bytes
    }
    
    FastAPIController ..> GenerateRequestDTO : "Deserializes"
    FastAPIController ..> ImageTensor : "Instantiates"
}

package "adapters.outbound" {
    class HuggingFaceVLMAdapter {
        - model_weights : Tensor
        + __init__(model_id: str)
        + predict_markup(image: ImageTensor) : TikzTokens
    }

    class TeXLiveCompilerAdapter {
        - timeout_seconds : int
        + __init__(timeout_seconds: int)
        + compile_to_pdf(tokens: TikzTokens) : CompilationResult
    }
}

' Architectural Flow & DIP Relationships
FastAPIController o-- GenerateTikzUseCase
ImageToTikZOrchestrator ..|> GenerateTikzUseCase

ImageToTikZOrchestrator o-- VLMInferencePort
ImageToTikZOrchestrator o-- TikZCompilerPort

HuggingFaceVLMAdapter ..|> VLMInferencePort
TeXLiveCompilerAdapter ..|> TikZCompilerPort

' Domain Model Dependencies
ImageToTikZOrchestrator ..> ImageTensor
ImageToTikZOrchestrator ..> TikzTokens
ImageToTikZOrchestrator ..> CompilationResult

@enduml
