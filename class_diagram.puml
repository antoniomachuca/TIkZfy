@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 80

package "Ports (Interfaces) [Domain Isolation]" {
    interface VLMInferencePort <<Interface>> {
        + predict_markup(image_tensor: Tensor) : str
    }

    interface TikZCompilerPort <<Interface>> {
        + compile_to_pdf(tikz_markup: str) : bytes
    }
}

package "Core Domain [Immutable Mathematical Core]" {
    class ImageToTikZOrchestrator {
        - vlm_port : VLMInferencePort
        - compiler_port : TikZCompilerPort
        + __init__(vlm: VLMInferencePort, compiler: TikZCompilerPort)
        + generate_pdf_from_image(image_tensor: Tensor) : bytes
    }
}

package "Adapters [External Infrastructure]" {
    class HuggingFaceVLMAdapter {
        - model_weights : Tensor
        + __init__(model_id: str)
        + predict_markup(image_tensor: Tensor) : str
    }

    class TeXLiveCompilerAdapter {
        - timeout_seconds : int
        + __init__(timeout_seconds: int)
        + compile_to_pdf(tikz_markup: str) : bytes
    }
}

ImageToTikZOrchestrator --> VLMInferencePort : "Injected Dependency (DIP)"
ImageToTikZOrchestrator --> TikZCompilerPort : "Injected Dependency (DIP)"

HuggingFaceVLMAdapter ..|> VLMInferencePort : "Implements"
TeXLiveCompilerAdapter ..|> TikZCompilerPort : "Implements"

note right of ImageToTikZOrchestrator
  **Single Responsibility (SRP):**
  Orchestrates the O(1) inference pipeline.
  Does not contain networking or I/O logic.
end note

note bottom of VLMInferencePort
  **Interface Segregation (ISP):**
  Atomic interface dedicated solely
  to neural inference propagation.
end note

@enduml
