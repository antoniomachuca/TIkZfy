# Version control and editor
.git
.gitignore
.github
.vscode
.idea

# Python environments, bytecode and caches
__pycache__
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
.env
.mypy_cache/
.pytest_cache/
.ruff_cache/
build/
dist/
*.egg-info/
tikzfy.egg-info/
image_to_tikz_engine.egg-info/

# Frontend (hosted independently)
/frontend/

